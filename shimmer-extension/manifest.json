{
  "manifest_version": 3,
  "name": "Shimmer Companion",
  "version": "1.5",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open Shimmer Companion" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["shimmercompanion.html", "shimmercompanion.js", "chart.min.js", "vendor/shimmer-web-sdk.esm.js", "cloudsync.js"],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
