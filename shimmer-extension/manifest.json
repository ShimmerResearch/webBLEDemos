{
  "manifest_version": 3,
  "name": "Shimmer Companion",
  "version": "1.3",
  "permissions": ["tabs", "scripting", "storage", "activeTab"],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.netflix.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": { "default_title": "Open Shimmer Companion" },
  "web_accessible_resources": [
    {
      "resources": ["shimmercompanion.html", "shimmercompanion.js", "chart.min.js", "shimmer3r.js"],
      "matches": [
        "https://www.youtube.com/*",
        "https://www.netflix.com/*"
      ]
    }
  ]
}
