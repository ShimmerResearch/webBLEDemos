.vs/
**/.vs/

# Extension signing keys — the private key must never be committed.
# (The PUBLIC key lives in manifest.json "key" and is fine to commit.)
*.pem
*.p12
*.pfx
*-private-key*

# Per-contributor editor preferences. `.vscode/launch.json` IS shared and
# tracked; settings.json is not — it has carried one machine's Live Server
# port into a pull request three times, because `git add -A` cannot tell an
# untracked local file from a new one that belongs.
.vscode/settings.json
